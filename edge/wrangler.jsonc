{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dgy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Every request goes through the Worker first, so question images are only served after login.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dgy",
      "database_id": "20658b7d-a615-49ec-8f89-6b22dda68392",
      "migrations_dir": "migrations"
    }
  ],
  // Accounts (see src/users.ts).
  //   id: never change it - each person's progress is stored under it, and 1 is where the existing progress went.
  //   name: the login user name.
  //   password_secret: name of the secret that holds the password, set with `npx wrangler secret put <name>`.
  "vars": {
    "USERS": [
      { "id": 1, "name": "ywt", "password_secret": "APP_PASSWORD" },
      { "id": 2, "name": "ssm", "password_secret": "FRIEND_PASSWORD" }
    ]
  },
  "routes": [
    { "pattern": "math.leadertestofcn.site", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
